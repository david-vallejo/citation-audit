# Claude (required for extraction). Needs a pay-as-you-go key from console.anthropic.com (a Claude.ai subscription won't work).
ANTHROPIC_API_KEY=
# claude-haiku-4-5 ≈ $0.01/profile (cheapest) · claude-sonnet-5 ≈ $0.02 · claude-opus-5 ≈ $0.05
CLAUDE_MODEL=claude-haiku-4-5
# Hard daily caps: the app refuses further Claude calls once either is hit (resets at midnight UTC).
DAILY_CLAUDE_CALLS=80
DAILY_COST_LIMIT_USD=1.00
# Page text sent to Claude is truncated to this many characters (~4 chars/token).
MAX_PAGE_CHARS=20000

# Google Places API (New) - canonical GBP facts
GOOGLE_PLACES_API_KEY=

# Discovery provider chain, comma-separated failover.
#   scraperapi-google = real Google results via the ScraperAPI key below (used automatically when that key is set)
#   google-cse        = Google Custom Search JSON API. Google now refuses it to new projects; kept for accounts that already have it
#   ddg               = keyless DuckDuckGo, rate-limits after a few quick queries
#   serpapi           = paid
DISCOVERY_PROVIDER=scraperapi-google,ddg
# How many "site:<directory>" queries per discovery (top directories first). Fewer = gentler on free providers.
DISCOVERY_SITE_QUERIES=6
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPAPI_KEY=

# Profile fetching. Big directories (Yelp, YP, BBB, Angi) block plain requests. Optional scraping proxy with a free tier:
#   scraperapi (1,000 free credits/mo, scraperapi.com) | scrapingbee (1,000 free trial credits)
FETCH_PROXY=
FETCH_PROXY_KEY=
# Attempts per page. The first is standard; later ones escalate to residential proxies.
PROXY_ATTEMPTS=3
# Geotargeting. Leave EMPTY on a free plan: sending country_code makes every request fail with a 500.
PROXY_COUNTRY=
# Fall back to the Wayback Machine when a profile is blocked (dated evidence; findings are routed to QA). 1|0
WAYBACK_FALLBACK=1

# Google Sheets output. Path to a service-account JSON. Leave blank to write CSVs to reports/<client>/ instead.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Comma-separated Google accounts to share each generated sheet with
SHEET_SHARE_WITH=

# Tuning
DB_PATH=data/citation-audit.sqlite
QA_CONFIDENCE_THRESHOLD=0.8
FETCH_CONCURRENCY=4
QA_PORT=8322
